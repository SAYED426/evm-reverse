# Copy to .env and adjust. All variables are optional.

# Ethereum RPC endpoint. Falls back to public endpoints, which are rate-limited.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# ---- Ollama (only needed for the `--llm` readability pass) ----

# Base URL of the Ollama-compatible endpoint.
# Local:  http://127.0.0.1:11434
# Remote: https://ollama.com
EVM_REVERSE_OLLAMA_URL=http://127.0.0.1:11434

# Bearer token, required by authenticated endpoints such as ollama.com.
EVM_REVERSE_OLLAMA_API_KEY=

# Default model for the readability pass.
EVM_REVERSE_LLM_MODEL=qwen2.5:7b

# ---- Web UI ----
PORT=8787
HOST=127.0.0.1

# ---- OpenCode plugin (Windows host with WSL) ----
# EVM_REVERSE_WSL_HOME=/home/you
# EVM_REVERSE_CLI=/home/you/evm-reverse/bin/evm-reverse
# EVM_REVERSE_OUTDIR=/home/you/reversed
# EVM_REVERSE_OPENCODE_DIR=/home/you/.config/opencode
